# ============================================================
# CONFIGURACIÓN DE ENTORNO - ZUMedical Sistema Prenatal
# ============================================================
# Copia este archivo como .env y llena los valores para desarrollo local
# En Railway, configura estas variables en el dashboard (Settings > Variables)

# --- Base de datos PostgreSQL (Neon o Railway) ---
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db?sslmode=require

# --- Django ---
# Genera una nueva clave segura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-segura-aqui

# --- Para PRODUCCIÓN ---
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*

# --- CONFIGURACIÓN SMTP (Gmail o tu proveedor de correo) ---
# Para Gmail, debes generar una contraseña de aplicación:
# 1. Ve a https://myaccount.google.com/apppasswords
# 2. Selecciona Mail y Windows (o tu dispositivo)
# 3. Copia la contraseña generada en EMAIL_HOST_PASSWORD
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
DEFAULT_FROM_EMAIL="ZUMedical" <tu-email@gmail.com>
